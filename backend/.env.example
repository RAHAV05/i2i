# ==========================================
# Doc Scanner - Clinic Demo MVP Configuration
# ==========================================

# Port for Flask backend server
PORT=5001

# AI Provider Configuration
# Currently supported: groq
# Planned: nvidia
AI_PROVIDER=groq

# Groq Vision Configuration
# Obtain your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Groq Vision Model:
# Supported vision models include:
# - qwen/qwen3.8-27b (recommended default for multi-modal clinical forms)
GROQ_MODEL=qwen/qwen3.8-27b

# Optional Future NVIDIA NIM Configuration
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
