# ==========================================
# Doc Scanner - Clinic Production Configuration
# ==========================================

PORT=5001

# AI Provider Configuration (gemini | groq)
AI_PROVIDER=gemini

# Gemini Configuration (Backend only, never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-pro-preview
GEMINI_THINKING_LEVEL=low
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Pricing & Exchange Rate (for cost logging in usage_ledger)
PRICE_IN_USD_PER_M=1.50
PRICE_OUT_USD_PER_M=7.50
FALLBACK_PRICE_IN_USD_PER_M=2.00
FALLBACK_PRICE_OUT_USD_PER_M=12.00
USD_INR=97

# Validation & Flagging Thresholds
FLAG_CONFIDENCE=0.8
FLAG_CONFIDENCE_MEASURE=0.9
IMAGE_MAX_EDGE_PX=1568
IMAGE_MAX_BYTES=1000000

# Rate Limiting
RATE_LIMIT_USER=10/minute
RATE_LIMIT_ORG=60/minute

# Database & Storage
DB_URL=postgresql://...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Payments & Invoicing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GST_RATE=0.18

# Compliance & Privacy (DPDP Act)
RETENTION_MONTHS=12
SENTRY_DSN=
